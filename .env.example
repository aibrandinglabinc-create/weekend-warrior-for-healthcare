# GoHighLevel inbound webhook URL that the /join registration form posts to.
# Copy this file to .env.local and fill in the real webhook URL. Never commit
# the real value.
VITE_JOIN_WEBHOOK_URL=

# GoHighLevel inbound webhook URL that the /facilities pod booking form posts to.
# Separate pipeline from the warrior registrations above.
VITE_FACILITY_WEBHOOK_URL=
